---
import { Font, Image } from 'astro:assets';
import '../styles/global.css';
import logoTagline from '../assets/logos/grand-daze-logo-tagline-black-cmyk.svg';
import logoMarkWhite from '../assets/logos/grand-daze-logo-mark-white-cmyk.svg';
import creeksideDazeLogo from '../assets/logos/creekside-daze-logo.webp';

interface Props {
	title: string;
	description?: string;
	activeRoute?: string;
}

const { title, description = 'Grand Daze — a family Bahamian retreat.', activeRoute = '/' } = Astro.props;
const base = import.meta.env.BASE_URL;
const href = (route: string) => `${base}${route === '/' ? '' : route}`;
const currentYear = new Date().getFullYear();
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={href('/favicon.svg')} />
		<link rel="icon" href={href('/favicon.ico')} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | Grand Daze</title>
		<Font cssVariable="--font-alcemo" />
		<Font cssVariable="--font-grandharbor" />
	</head>
	<body>
		<header class="site-header">
			<a class="site-mark" href={href('/')} aria-label="Grand Daze home">
				<Image src={logoTagline} alt="Grand Daze" width={225} class="site-logo" />
			</a>
			<nav class="site-nav" aria-label="Primary navigation">
				<a class:list={{ 'is-active': activeRoute === '/' }} href={href('/')} aria-current={activeRoute === '/' ? 'page' : undefined}>
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1V10Z" /></svg>
					<span>Home</span>
				</a>
				<a class:list={{ 'is-active': activeRoute === '/explore' }} href={href('/explore')} aria-current={activeRoute === '/explore' ? 'page' : undefined}>Explore</a>
				<a class:list={{ 'is-active': activeRoute === '/gallery' }} href={href('/gallery')} aria-current={activeRoute === '/gallery' ? 'page' : undefined}>Gallery</a>
				<a class:list={{ 'is-active': activeRoute === '/guide' }} href={href('/guide')} aria-current={activeRoute === '/guide' ? 'page' : undefined}>Local Guide</a>
			</nav>
		</header>

		<main>
			<slot />
		</main>

		<footer class="site-footer">
			<div class="site-footer-content">
				<span class="site-footer-subtitle">Looking for a different view?</span>
				<div class="site-footer-brand">
					<a href="https://creeksidedaze.com" target="_blank" rel="noopener noreferrer" aria-label="Visit Creekside Daze">
						<Image src={creeksideDazeLogo} alt="Creekside Daze" width={320} class="site-footer-brand-mark" />
					</a>
				</div>
				<div class="site-footer-links">
					<div class="social-links" aria-label="Social media">
						<a href="https://www.instagram.com/grand_daze_bahamas" target="_blank" rel="noreferrer" aria-label="Instagram">
							<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" /><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37Z" /><line x1="17.5" y1="6.5" x2="17.51" y2="6.5" /></svg>
						</a>
						<a href="https://www.facebook.com/people/Grand-daze-Bahamas/61564691083087/" target="_blank" rel="noreferrer" aria-label="Facebook">
							<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3Z" /></svg>
						</a>
						<a href={href('/credits')}>Credits</a>
					</div>
					<div class="site-footer-copyright">
						<Image src={logoMarkWhite} alt="" width={32} class="site-footer-logo" />
						<small>&copy; {currentYear} Grand Daze. All rights reserved.</small>
					</div>
				</div>
			</div>
		</footer>

		<div class="image-viewer" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Image viewer">
			<button class="image-viewer-close" type="button" aria-label="Close image viewer">&times;</button>
			<button class="image-viewer-control image-viewer-previous" type="button" aria-label="Previous image">&#8592;</button>
			<figure class="image-viewer-figure">
				<img class="image-viewer-image" alt="" />
				<figcaption class="image-viewer-caption"></figcaption>
			</figure>
			<button class="image-viewer-control image-viewer-next" type="button" aria-label="Next image">&#8594;</button>
		</div>

		<script>
			const viewer = document.querySelector('.image-viewer');
			const viewerImage = viewer?.querySelector('.image-viewer-image');
			const viewerCaption = viewer?.querySelector('.image-viewer-caption');
			const galleryImages = Array.from(document.querySelectorAll('main img:not([data-image-viewer-ignore])'));
			let viewerImages = galleryImages.map((image) => ({
				src: image.currentSrc || image.src,
				alt: image.dataset.viewerAlt || image.alt,
			}));
			let activeImageIndex = 0;
			let touchStart: { x: number; y: number } | undefined;

			const updateViewer = () => {
				const image = viewerImages[activeImageIndex];
				if (!image || !viewerImage || !viewerCaption) return;
				viewerImage.src = image.src;
				viewerImage.alt = image.alt;
				viewerCaption.textContent = image.alt;
			};

			const closeViewer = () => {
				viewer?.classList.remove('is-open');
				viewer?.setAttribute('aria-hidden', 'true');
				document.body.classList.remove('is-viewer-open');
				window.dispatchEvent(new CustomEvent('granddaze:close-image-viewer'));
			};

			const openViewer = (index: number, images = galleryImages.map((image) => ({
				src: image.currentSrc || image.src,
				alt: image.dataset.viewerAlt || image.alt,
			}))) => {
				if (images.length === 0 || index < 0 || index >= images.length) {
					throw new Error('The image viewer received an invalid image selection.');
				}
				viewerImages = images;
				activeImageIndex = index;
				updateViewer();
				viewer?.classList.add('is-open');
				viewer?.setAttribute('aria-hidden', 'false');
				document.body.classList.add('is-viewer-open');
			};

			const moveViewer = (direction: number) => {
				activeImageIndex = (activeImageIndex + direction + viewerImages.length) % viewerImages.length;
				updateViewer();
			};

			galleryImages.forEach((image, index) => {
				if (image.closest('[data-overlay-player]')) return;
				image.classList.add('image-viewer-trigger');
				image.setAttribute('tabindex', '0');
				image.setAttribute('role', 'button');
				const openImage = () => openViewer(index);
				image.addEventListener('click', openImage);
				image.addEventListener('keydown', (event) => {
					if (event.key === 'Enter' || event.key === ' ') {
						event.preventDefault();
						openImage();
					}
				});
			});

			window.addEventListener('granddaze:open-image-viewer', (event) => {
				if (!(event instanceof CustomEvent)) return;
				const detail: unknown = event.detail;
				if (!detail || typeof detail !== 'object') {
					throw new Error('OrbitCards requested the image viewer without image data.');
				}

				const { index, items } = detail as { index?: unknown; items?: unknown };
				if (!Number.isInteger(index) || !Array.isArray(items) || items.length === 0) {
					throw new Error('OrbitCards requested the image viewer with invalid image data.');
				}

				const images = items.map((item: unknown) => {
					if (!item || typeof item !== 'object') {
						throw new Error('OrbitCards image data must contain an image and alt text.');
					}
					const { src, alt } = item as { src?: unknown; alt?: unknown };
					if (typeof src !== 'string' || typeof alt !== 'string') {
						throw new Error('OrbitCards image data must contain an image and alt text.');
					}
					return { src, alt };
				});
				openViewer(index, images);
			});

			viewer?.querySelector('.image-viewer-close')?.addEventListener('click', closeViewer);
			viewer?.querySelector('.image-viewer-previous')?.addEventListener('click', () => moveViewer(-1));
			viewer?.querySelector('.image-viewer-next')?.addEventListener('click', () => moveViewer(1));
			viewer?.addEventListener('touchstart', (event) => {
				if (!viewer.classList.contains('is-open') || event.touches.length !== 1) {
					touchStart = undefined;
					return;
				}

				const touch = event.touches[0];
				touchStart = { x: touch.clientX, y: touch.clientY };
			}, { passive: true });
			viewer?.addEventListener('touchend', (event) => {
				if (!touchStart || !viewer.classList.contains('is-open')) return;

				const touch = event.changedTouches[0];
				const deltaX = touch.clientX - touchStart.x;
				const deltaY = touch.clientY - touchStart.y;
				touchStart = undefined;

				if (Math.abs(deltaX) < 50 || Math.abs(deltaX) <= Math.abs(deltaY) * 1.2) return;
				moveViewer(deltaX < 0 ? 1 : -1);
			}, { passive: true });
			viewer?.addEventListener('touchcancel', () => { touchStart = undefined; }, { passive: true });
			viewer?.addEventListener('click', (event) => {
				if (event.target === viewer) closeViewer();
			});
			document.addEventListener('keydown', (event) => {
				if (!viewer?.classList.contains('is-open')) return;
				if (event.key === 'Escape') closeViewer();
				if (event.key === 'ArrowLeft') moveViewer(-1);
				if (event.key === 'ArrowRight') moveViewer(1);
			});
		</script>
	</body>
</html>
