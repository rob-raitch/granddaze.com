---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import heroMark from '../assets/images/grand-daze-both-levels-stylized.webp';
import heroMarkAlt from '../assets/images/grand-daze-waterfront.webp';
---

<Layout title="Home" activeRoute="/" description="Grand Daze — a family Bahamian retreat, coming soon.">
	<section class="home-hero">
		<div class="home-hero-copy">
			<p class="eyebrow">Luxury inspired family retreat</p>
			<h1>Elbow Cay<br /><em>Abacos, Bahamas</em></h1>
			<p class="lede">Grand Daze is a place for sun-soaked days, shared meals, and making memories at an unhurried pace.</p>
			<a class="button-link" href={`${import.meta.env.BASE_URL}explore`}>Begin exploring <span aria-hidden="true">↗</span></a>
		</div>
		<div class="home-hero-mark">
			<div class="hero-mark-image">
				<Image src={heroMark} alt="Grand Daze" width={560} />
				<Image src={heroMarkAlt} alt="" width={560} class="hero-mark-image-alt" />
				<span class="hero-mark-tagline">From plans to reality</span>
			</div>
            <span>Booking Calendar</span>
			<span>Coming Soon</span>
		</div>
	</section>
	<section class="home-note">
		<p class="eyebrow">Another memorable daze</p>
		<h2>Bringing you the Bahamas vibe</h2>
		<p>We are building Grand Daze with the same spirit we hope to share: warm, easy, and full of possibility.</p>
	    <p>Please visit our sister property<a href="https://creeksidedaze.com" target="_blank" rel="noopener noreferrer"> Creekside Daze</a> for a mountain retreat.</p>
    </section>
</Layout>
