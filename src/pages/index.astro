---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import logotypeWhite from '../assets/logos/grand-daze-logotype-white-rgb-900px-w-300ppi.png';
---

<Layout title="Home" activeRoute="/" description="Grand Daze — a family Bahamian retreat, coming soon.">
	<section class="home-hero">
		<div class="home-hero-copy">
			<p class="eyebrow">A family Bahamian retreat</p>
			<h1>Come as you are.<br /><em>Stay awhile.</em></h1>
			<p class="lede">Grand Daze is a place for sun-soaked days, shared meals, and making memories at an unhurried pace.</p>
			<a class="button-link" href={`${import.meta.env.BASE_URL}explore`}>Begin exploring <span aria-hidden="true">↗</span></a>
		</div>
		<div class="home-hero-mark">
			<Image src={logotypeWhite} alt="Grand Daze" width={360} />
			<span>Coming soon</span>
		</div>
	</section>
	<section class="home-note">
		<p class="eyebrow">A little more time</p>
		<h2>The best kind of plans are the ones with room to change.</h2>
		<p>We are building Grand Daze with the same spirit we hope to share: warm, easy, and full of possibility.</p>
	</section>
</Layout>
