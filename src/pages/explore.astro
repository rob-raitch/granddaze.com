---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import primaryBedroom from '../assets/images/primary-bedroom.webp';
import primaryBedroomTwo from '../assets/images/primary-bedroom2.webp';
import primaryBedroomEnsuite from '../assets/images/primary-bedroom-ensuite.webp';
import bedroom2 from '../assets/images/bedroom2.webp';
import bedroom2ensuite from '../assets/images/bedroom2-ensuite.webp';
import bedroom3 from '../assets/images/bedroom3.webp';
import bedroom3ensuite from '../assets/images/bedroom3-ensuite.webp';
import downstairs from '../assets/images/downstairs.webp';
import laundry3 from '../assets/images/laundry3.webp';

const destinationFeatures = [
	{
		images: [
			{ src: primaryBedroomEnsuite, alt: 'Master bedroom ensuite bath' },
			{ src: primaryBedroomTwo, alt: 'Master bedroom seating area' },
			{ src: primaryBedroom, alt: 'Master bedroom' },
		],
		label: 'Master Suite',
		eyebrow: 'Stay awhile',
		title: 'Wake up somewhere worth lingering.',
		description: 'Light-filled rooms, soft textures, and a view that makes slow mornings feel effortless.',
	},
	{
		images: [
			{ src: bedroom2ensuite, alt: 'Second bedroom ensuite bath' },
			{ src: bedroom2, alt: 'Second bedroom' },
		],
		label: 'Second bedroom',
		eyebrow: 'Make it yours',
		title: 'A generous place to land.',
		description: 'Every corner is designed for easy days, shared stories, and time together.',
	},
    {
		images: [
			{ src: bedroom3ensuite, alt: 'Third bedroom ensuite bath' },
			{ src: bedroom3, alt: 'Third bedroom' },
		],
		label: 'Third bedroom',
		eyebrow: 'Settle in',
		title: 'Details that make the difference.',
		description: 'Thoughtful spaces give every day at Grand Daze a little more room to breathe.',
	},
    {
		images: [
			{ src: downstairs, alt: 'Downstairs' },
			{ src: laundry3, alt: 'Laundry area' },
		],
		label: 'More previews',
		eyebrow: 'Relax',
		title: 'Around the villa.',
		description: 'Everything for a perfect getaway.',
	},
];
---

<Layout title="Explore" activeRoute="/explore" description="A first look at the spirit and setting of Grand Daze.">
	<section class="editorial-hero explore-intro">
		<p class="eyebrow">The island, slowly revealed</p>
		<h1>Make room for <em>more</em> than a getaway.</h1>
		<p class="lede">Grand Daze is a relaxing home base for sunny days, memorable adventures, and the easy rhythm of the Bahamas.</p>
	</section>

	{destinationFeatures.map((feature, index) => (
		<section class="destination-feature" aria-labelledby={`destination-title-${index + 1}`}>
			<div class="destination-art">
				<div class="destination-images">
					{feature.images.map((image, imageIndex) => (
						<Image
							src={image.src}
							alt={image.alt}
							width={900}
							class={`destination-image destination-image-${(imageIndex % 3) + 1}`}
							loading="lazy"
						/>
					))}
				</div>
				<span class="feature-note">{feature.label}</span>
			</div>
			<div class="feature-copy">
				<p class="eyebrow">{feature.eyebrow}</p>
				<h2 id={`destination-title-${index + 1}`}>{feature.title}</h2>
				<p>{feature.description}</p>
				<a class="text-link" href={`${import.meta.env.BASE_URL}/guide/`}>Start with the local guide <span aria-hidden="true">↗</span></a>
			</div>
		</section>
	))}

	<section class="content-teaser">
		<p class="eyebrow">Coming into view</p>
		<h2>Island notes, neighborhood favorites, and room to wander.</h2>
		<div class="teaser-grid">
			<article><span>01</span><h3>Slow mornings</h3><p>Coffee, sea breeze, nowhere else to be.</p></article>
			<article><span>02</span><h3>Bright afternoons</h3><p>Follow the light and see where it leads.</p></article>
			<article><span>03</span><h3>Evenings together</h3><p>Bring everyone to the table.</p></article>
		</div>
	</section>
</Layout>
