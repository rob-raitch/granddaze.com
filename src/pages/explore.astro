---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import { propertyPhotos } from '../data/property-photos';

const destinationFeatures = [
    {
		images: propertyPhotos.slice(0, 3),
		label: 'Family Getaway',
		eyebrow: 'Relax',
		title: 'Around the villa.',
		description: 'Everything for a perfect getaway.',
	},
	{
		images: propertyPhotos.slice(3, 6),
		label: 'Master Suite',
		eyebrow: 'Stay awhile',
		title: 'Wake up somewhere worth lingering.',
		description: 'Light-filled rooms, soft textures, and a view that makes slow mornings feel effortless.',
	},
	{
		images: propertyPhotos.slice(6, 9),
		label: 'Second bedroom',
		eyebrow: 'Make it yours',
		title: 'A generous place to land.',
		description: 'Every corner is designed for easy days, shared stories, and time together.',
	},
    {
		images: propertyPhotos.slice(9, 12),
		label: 'Third bedroom',
		eyebrow: 'Settle in',
		title: 'Details that make the difference.',
		description: 'Thoughtful spaces give every day at Grand Daze a little more room to breathe.',
	},
];
---

<Layout title="Explore" activeRoute="/explore" description="Explore the spirit and setting of Grand Daze.">
	<section class="editorial-hero explore-intro">
		<p class="eyebrow">The island, slowly revealed</p>
		<h1>Make room for <em>more</em> than a getaway.</h1>
		<p class="lede">Grand Daze is a relaxing home base for sunny days, memorable adventures, and the easy rhythm of the Bahamas.</p>
        <p>*Click any image on the page for a closer look</p>
	</section>

	{destinationFeatures.map((feature, index) => (
		<section class="destination-feature" aria-labelledby={`destination-title-${index + 1}`}>
			<div class="destination-art">
				<div class="destination-images">
					{feature.images.map((image, imageIndex) => (
						<Image
							src={image.image}
							alt={image.alt}
							width={900}
							class={`destination-image destination-image-${(imageIndex % 3) + 1}`}
							loading="lazy"
						/>
					))}
				</div>
				<span class="feature-note">{feature.label}</span>
			</div>
			<div class="feature-copy">
				<p class="eyebrow">{feature.eyebrow}</p>
				<h2 id={`destination-title-${index + 1}`}>{feature.title}</h2>
				<p>{feature.description}</p>
				<a class="text-link" href={`${import.meta.env.BASE_URL}/guide/`}>Start with the local guide <span aria-hidden="true">↗</span></a>
			</div>
		</section>
	))}

</Layout>
