---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import emblemWhite from '../assets/logos/grand-daze-logo-emblem-white-rgb-900px-w-300ppi.png';

const destinationImages = Object.values(
	import.meta.glob('../assets/images/*.{jpg,jpeg,png,webp,avif}', {
		eager: true,
		import: 'default',
		query: '?url',
	}),
);
---

<Layout title="Explore" activeRoute="/explore" description="A first look at the spirit and setting of Grand Daze.">
	<section class="editorial-hero explore-intro">
		<p class="eyebrow">The island, slowly revealed</p>
		<h1>Make room for <em>more</em> than a getaway.</h1>
		<p class="lede">Grand Daze is a relaxing home base for sunny days, memorable adventures, and the easy rhythm of the Bahamas.</p>
	</section>

	<section class="destination-feature" aria-labelledby="destination-title">
		<div class="destination-art">
			<div class="destination-images" aria-hidden="true">
				{destinationImages.map((image, index) => (
					<img src={image} alt="" class={`destination-image destination-image-${(index % 3) + 1}`} loading="lazy" />
				))}
			</div>
			<div class="sun-glow"></div>
			<div class="horizon"></div>
			<div class="water-line water-line-one"></div>
			<div class="water-line water-line-two"></div>
			<Image src={emblemWhite} alt="" width={220} class="feature-emblem" />
			<span class="feature-note">A place to<br />come back to</span>
		</div>
		<div class="feature-copy">
			<p class="eyebrow">A sense of place</p>
			<h2 id="destination-title">Somewhere between salt air and staying awhile.</h2>
			<p>We are gathering the details now: the colors, the corners, and the small rituals that will make Grand Daze feel like yours from the moment you arrive.</p>
			<a class="text-link" href={`${import.meta.env.BASE_URL}guide`}>Start with the local guide <span aria-hidden="true">↗</span></a>
		</div>
	</section>

	<section class="content-teaser">
		<p class="eyebrow">Coming into view</p>
		<h2>Island notes, neighborhood favorites, and room to wander.</h2>
		<div class="teaser-grid">
			<article><span>01</span><h3>Slow mornings</h3><p>Coffee, sea breeze, nowhere else to be.</p></article>
			<article><span>02</span><h3>Bright afternoons</h3><p>Follow the light and see where it leads.</p></article>
			<article><span>03</span><h3>Evenings together</h3><p>Bring everyone to the table.</p></article>
		</div>
	</section>
</Layout>
