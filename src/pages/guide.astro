---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Local Guide" activeRoute="/guide" description="The Grand Daze local guide is on its way.">
	<section class="centered-page editorial-hero">
		<p class="eyebrow">Local guide</p>
		<h1>Follow the good feeling.</h1>
		<p class="lede">The best days are rarely over-planned. Our guide will collect the places, flavors, and little discoveries that make time in the Bahamas linger.</p>
		<div class="link-card-grid">
			<a class="link-card" href={`${import.meta.env.BASE_URL}explore`}><span>Explore the setting</span><strong>↗</strong></a>
			<a class="link-card" href={`${import.meta.env.BASE_URL}credits`}><span>Meet the makers</span><strong>↗</strong></a>
		</div>
	</section>
</Layout>
