---
import { getImage, Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import projectorImage from '../assets/logos/projector-vectorportal.svg';

interface OrbitCardItem {
	title: string;
	image: ImageMetadata | string;
	alt: string;
	subtitle?: string;
	description?: string;
	href?: string;
	linkLabel?: string;
}

interface Props {
	heading: string;
	description?: string;
	items: OrbitCardItem[];
	overlayPlayer?: boolean;
	visibleCards?: number;
	autoplayInterval?: number;
}

const {
	heading,
	description,
	items,
	overlayPlayer = false,
	visibleCards,
	autoplayInterval,
} = Astro.props;

if (items.length === 0) {
	throw new Error('OrbitCards requires at least one item.');
}

if (visibleCards !== undefined && (!Number.isInteger(visibleCards) || visibleCards < 1)) {
	throw new Error('OrbitCards visibleCards must be a positive integer.');
}

if (autoplayInterval !== undefined && (!Number.isInteger(autoplayInterval) || autoplayInterval < 1)) {
	throw new Error('OrbitCards autoplayInterval must be a positive integer.');
}

const isVirtualized = visibleCards !== undefined && visibleCards < items.length;
const cardItems = isVirtualized ? items.slice(0, visibleCards) : items;
const virtualItems = isVirtualized
	? await Promise.all(items.map(async (item) => {
		const image = await getImage({
			src: item.image,
			width: overlayPlayer ? 1200 : 560,
			format: 'webp',
		});

		return { title: item.title, alt: item.alt, src: image.src };
	}))
	: undefined;
---

<section
	class="orbit-section"
	data-orbit-carousel
	data-overlay-player={overlayPlayer ? 'true' : undefined}
	data-orbit-items={virtualItems ? JSON.stringify(virtualItems) : undefined}
	data-autoplay-interval={autoplayInterval}
	aria-label={heading}
>
	<header class="orbit-heading">
		<h2>{heading}</h2>
		{description && <p>{description}</p>}
	</header>

	<div class="orbit-wrapper">
		{virtualItems && (
			<div class="orbit-projector" aria-hidden="true">
				<img src={projectorImage.src} alt="" />
			</div>
		)}
		<div class="orbit-ring" data-orbit-ring>
			{cardItems.map((item, index) => (
				<button
					class="orbit-card"
					type="button"
					data-orbit-card
					data-item-index={index}
					data-title={item.title}
					data-subtitle={item.subtitle}
					data-description={item.description}
					data-alt={item.alt}
					data-href={item.href}
					data-link-label={item.linkLabel}
					aria-label={`View details for ${item.title}`}
					aria-current={index === 0 ? 'true' : undefined}
				>
					{virtualItems ? (
						<img
							src={virtualItems[index].src}
							alt=""
							class="orbit-card-image"
							data-viewer-alt={item.alt}
							data-image-viewer-ignore={overlayPlayer ? '' : undefined}
						/>
					) : (
						<Image
							src={item.image}
							alt=""
							width={overlayPlayer ? 1200 : 560}
							class="orbit-card-image"
							data-viewer-alt={item.alt}
							data-image-viewer-ignore={!overlayPlayer ? '' : undefined}
						/>
					)}
					<span class="orbit-card-shade" aria-hidden="true"></span>
					<span class="orbit-card-content">
						<span class="orbit-card-title">{item.title}</span>
						{item.subtitle && <span class="orbit-card-subtitle">{item.subtitle}</span>}
					</span>
				</button>
			))}
		</div>
		{!virtualItems && (
			<>
				<button class="orbit-arrow orbit-arrow-previous" type="button" data-orbit-previous aria-label="Show previous card">
					<span aria-hidden="true">←</span>
				</button>
				<button class="orbit-arrow orbit-arrow-next" type="button" data-orbit-next aria-label="Show next card">
					<span aria-hidden="true">→</span>
				</button>
			</>
		)}
	</div>
	{virtualItems && (
		<div class="orbit-controls">
			<button class="orbit-arrow orbit-arrow-previous" type="button" data-orbit-previous aria-label="Show previous card">
				<span aria-hidden="true">←</span>
			</button>
			<span class="orbit-control-label">Rotate The Slide Tray</span>
			<button class="orbit-arrow orbit-arrow-next" type="button" data-orbit-next aria-label="Show next card">
				<span aria-hidden="true">→</span>
			</button>
		</div>
	)}

	<dialog class="orbit-dialog" data-orbit-dialog aria-label="Selected card details">
		<button class="orbit-dialog-close" type="button" data-orbit-close aria-label="Close details">&times;</button>
		<div class="orbit-dialog-image" data-orbit-dialog-image></div>
		<div class="orbit-dialog-content">
			<p class="orbit-dialog-subtitle" data-orbit-dialog-subtitle hidden></p>
			<h3 data-orbit-dialog-title></h3>
			<p class="orbit-dialog-description" data-orbit-dialog-description hidden></p>
			<a class="orbit-dialog-link" data-orbit-dialog-link hidden></a>
		</div>
	</dialog>
</section>

<script>
	const carousels = document.querySelectorAll<HTMLElement>('[data-orbit-carousel]');

	carousels.forEach((carousel) => {
		const ring = carousel.querySelector<HTMLElement>('[data-orbit-ring]');
		const cards = Array.from(carousel.querySelectorAll<HTMLButtonElement>('[data-orbit-card]'));
		const previousButton = carousel.querySelector<HTMLButtonElement>('[data-orbit-previous]');
		const nextButton = carousel.querySelector<HTMLButtonElement>('[data-orbit-next]');
		const dialog = carousel.querySelector<HTMLDialogElement>('[data-orbit-dialog]');
		const closeButton = carousel.querySelector<HTMLButtonElement>('[data-orbit-close]');
		const dialogImage = carousel.querySelector<HTMLDivElement>('[data-orbit-dialog-image]');
		const dialogTitle = carousel.querySelector<HTMLHeadingElement>('[data-orbit-dialog-title]');
		const dialogSubtitle = carousel.querySelector<HTMLParagraphElement>('[data-orbit-dialog-subtitle]');
		const dialogDescription = carousel.querySelector<HTMLParagraphElement>('[data-orbit-dialog-description]');
		const dialogLink = carousel.querySelector<HTMLAnchorElement>('[data-orbit-dialog-link]');
		const overlayPlayer = carousel.dataset.overlayPlayer === 'true';
		const virtualItems = carousel.dataset.orbitItems
			? JSON.parse(carousel.dataset.orbitItems) as Array<{ title: string; alt: string; src: string }>
			: undefined;
		const autoplayInterval = Number(carousel.dataset.autoplayInterval);

		if (!ring || !previousButton || !nextButton || !dialog || !closeButton || !dialogImage || !dialogTitle || !dialogSubtitle || !dialogDescription || !dialogLink) {
			throw new Error('OrbitCards is missing required markup.');
		}

		let activeIndex = 0;
		let virtualStart = 0;
		let virtualPhase = 0;
		let pendingDirection: -1 | 1 | undefined;
		let autoplayTimer: number | undefined;
		let transitionFallback: number | undefined;
		const step = 360 / cards.length;
		const virtualStep = cards.length > 1 ? (Math.PI * 0.9) / (cards.length - 1) : 0;
		const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

		if (virtualItems && cards.length >= virtualItems.length) {
			throw new Error('OrbitCards virtualization requires more items than visible cards.');
		}

		const updateOrbit = () => {
			const cardWidth = cards[0]?.clientWidth || 220;
			const { width: stageWidth, height: stageHeight } = ring.getBoundingClientRect();

			if (virtualItems) {
				const maxAngle = virtualStep * (cards.length - 1) / 2;
				const radiusX = Math.max(0, stageWidth / 2 - cardWidth * 0.35);
				const radiusY = stageHeight * 0.22;
				const radiusZ = Math.min(stageWidth * 0.3, 240);
				const phase = virtualPhase / virtualStep;

				cards.forEach((card, index) => {
					const angle = -maxAngle + (index - phase) * virtualStep;
					const depth = Math.cos(angle);
					const x = Math.sin(angle) * radiusX;
					const y = (1 - depth) * radiusY;
					const z = depth * radiusZ;
					const isPrimary = Math.abs(angle) <= virtualStep / 2;
					const scale = (0.55 + depth * 0.45) * (isPrimary ? 1.18 : 1);
					const rotation = index >= cards.length / 2 - 1 && index <= cards.length / 2
						? 0
						: -angle;

					card.style.transform = `translate(-50%, -50%) translate3d(${x}px, ${y}px, ${z}px) rotateY(${rotation}rad) scale(${scale})`;
					card.style.zIndex = String(Math.round((depth + 1) * 50));
					if (index === activeIndex) {
						card.setAttribute('aria-current', 'true');
					} else {
						card.removeAttribute('aria-current');
					}
				});
				return;
			}

			const radius = cards.length < 3
				? cardWidth * 0.8
				: Math.max(cardWidth * 0.8, Math.min(stageWidth * 0.56, cardWidth / (2 * Math.tan(Math.PI / cards.length))));

			ring.style.transform = `rotateY(${-activeIndex * step}deg)`;
			cards.forEach((card, index) => {
				card.style.transform = `rotateY(${index * step}deg) translateZ(${radius}px)`;
				if (index === activeIndex) {
					card.setAttribute('aria-current', 'true');
				} else {
					card.removeAttribute('aria-current');
				}
			});
		};

		const setVirtualCard = (card: HTMLButtonElement, itemIndex: number) => {
			if (!virtualItems) return;
			const index = (itemIndex + virtualItems.length) % virtualItems.length;
			const item = virtualItems[index];
			const image = card.querySelector<HTMLImageElement>('.orbit-card-image');
			const title = card.querySelector<HTMLElement>('.orbit-card-title');
			const subtitle = card.querySelector<HTMLElement>('.orbit-card-subtitle');

			if (!item || !image || !title) {
				throw new Error('OrbitCards could not update a virtual card.');
			}

			card.dataset.itemIndex = String(index);
			card.dataset.title = item.title;
			card.dataset.alt = item.alt;
			card.setAttribute('aria-label', `View details for ${item.title}`);
			image.src = item.src;
			image.dataset.viewerAlt = item.alt;
			title.textContent = item.title;
			if (subtitle) subtitle.textContent = '';
		};

		const finishVirtualMove = (direction: -1 | 1) => {
			if (transitionFallback !== undefined) window.clearTimeout(transitionFallback);

			if (direction === 1) {
				const outgoing = cards.shift();
				if (!outgoing) throw new Error('OrbitCards could not advance its virtual carousel.');
				cards.push(outgoing);
				ring.append(outgoing);
				virtualStart = (virtualStart + 1) % virtualItems!.length;
				setVirtualCard(outgoing, virtualStart + cards.length - 1);
			} else {
				const incoming = cards.pop();
				if (!incoming) throw new Error('OrbitCards could not reverse its virtual carousel.');
				cards.unshift(incoming);
				ring.prepend(incoming);
				virtualStart = (virtualStart - 1 + virtualItems!.length) % virtualItems!.length;
				const image = incoming.querySelector<HTMLImageElement>('.orbit-card-image');
				if (image) image.style.opacity = '0';
				setVirtualCard(incoming, virtualStart);
				if (image) requestAnimationFrame(() => { image.style.opacity = ''; });
			}

			activeIndex = 0;
			virtualPhase = 0;
			cards.forEach((card) => { card.style.transition = 'none'; });
			updateOrbit();
			cards.forEach((card) => card.getBoundingClientRect());
			requestAnimationFrame(() => { cards.forEach((card) => { card.style.transition = ''; }); });
			pendingDirection = undefined;
		};

		const stopAutoplay = () => {
			if (autoplayTimer !== undefined) window.clearTimeout(autoplayTimer);
			autoplayTimer = undefined;
		};

		const scheduleAutoplay = () => {
			stopAutoplay();
			if (!virtualItems || !autoplayInterval || reducedMotion.matches || document.hidden) return;

			autoplayTimer = window.setTimeout(() => {
				if (!dialog.open && !pendingDirection) move(1);
				scheduleAutoplay();
			}, autoplayInterval);
		};

		const showDetails = (card: HTMLButtonElement) => {
			const image = card.querySelector('img')?.cloneNode(true);
			if (image instanceof HTMLImageElement) {
				image.alt = card.dataset.alt ?? card.dataset.title ?? '';
				dialogImage.replaceChildren(image);
			}

			dialogTitle.textContent = card.dataset.title ?? '';
			dialogSubtitle.textContent = card.dataset.subtitle ?? '';
			dialogSubtitle.hidden = !card.dataset.subtitle;
			dialogDescription.textContent = card.dataset.description ?? '';
			dialogDescription.hidden = !card.dataset.description;

			if (card.dataset.href) {
				dialogLink.href = card.dataset.href;
				dialogLink.textContent = card.dataset.linkLabel || 'Learn more';
				dialogLink.hidden = false;
			} else {
				dialogLink.removeAttribute('href');
				dialogLink.hidden = true;
			}

			dialog.showModal();
		};

		const move = (direction: -1 | 1, manual = false) => {
			if (virtualItems) {
				if (manual) scheduleAutoplay();
				if (pendingDirection) return;
				pendingDirection = direction;
				if (reducedMotion.matches) {
					finishVirtualMove(direction);
				} else {
					virtualPhase += direction * virtualStep;
					activeIndex = (activeIndex + direction + cards.length) % cards.length;
					updateOrbit();
					transitionFallback = window.setTimeout(() => finishVirtualMove(direction), 700);
				}
				return;
			}

			activeIndex = (activeIndex + direction + cards.length) % cards.length;
			updateOrbit();
		};

		cards.forEach((card, index) => {
			card.addEventListener('click', () => {
				if (!virtualItems) {
					activeIndex = index;
					updateOrbit();
				}

				if (overlayPlayer) {
					const image = card.querySelector('img');
					if (!image) throw new Error('OrbitCards item is missing its image.');
					stopAutoplay();
					window.dispatchEvent(new CustomEvent('granddaze:open-image-viewer', {
						detail: {
							index: Number(card.dataset.itemIndex),
							items: virtualItems ?? cards.map((visibleCard) => {
								const cardImage = visibleCard.querySelector<HTMLImageElement>('img');
								if (!cardImage) throw new Error('OrbitCards item is missing its image.');
								return {
									src: cardImage.currentSrc || cardImage.src,
									alt: visibleCard.dataset.alt ?? '',
								};
							}),
						},
					}));
					return;
				}

				showDetails(card);
			});
		});
		previousButton.addEventListener('click', () => move(-1, true));
		nextButton.addEventListener('click', () => move(1, true));
		ring.addEventListener('transitionend', (event) => {
			if (event.propertyName === 'transform' && pendingDirection && cards.includes(event.target as HTMLButtonElement)) {
				finishVirtualMove(pendingDirection);
			}
		});
		closeButton.addEventListener('click', () => dialog.close());
		dialog.addEventListener('close', scheduleAutoplay);
		window.addEventListener('granddaze:close-image-viewer', scheduleAutoplay);
		reducedMotion.addEventListener('change', scheduleAutoplay);
		dialog.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') {
				event.preventDefault();
				dialog.close();
			}
		});
		dialog.addEventListener('click', (event) => {
			if (event.target === dialog) dialog.close();
		});

		const resizeObserver = new ResizeObserver(updateOrbit);
		resizeObserver.observe(ring);
		document.addEventListener('visibilitychange', scheduleAutoplay);
		updateOrbit();
		scheduleAutoplay();
	});
</script>

<style>
	.orbit-section {
		background: var(--color-blue-dianne, #2a494c);
		color: var(--color-text-light, #f0f4f2);
		margin: 0 auto;
		max-width: calc(var(--content-width, 1200px) - 40px);
		overflow: hidden;
		padding: clamp(48px, 8vw, 88px) clamp(20px, 5vw, 64px);
	}

	.orbit-heading {
		margin: 0 auto 24px;
		max-width: 640px;
		text-align: center;
	}

	.orbit-heading h2 {
		font-size: clamp(2.4rem, 5vw, 4.5rem);
	}

	.orbit-heading p {
		color: var(--color-summer-green, #a1b8aa);
		margin-top: 16px;
	}

	.orbit-wrapper {
		height: clamp(360px, 46vw, 500px);
		margin: 0 auto;
		max-width: 900px;
		perspective: 1200px;
		position: relative;
	}

	.orbit-section[data-orbit-items] .orbit-wrapper {
		height: clamp(460px, 40vw, 520px);
	}

	.orbit-projector {
		align-items: center;
		display: flex;
		inset: 0;
		justify-content: center;
		pointer-events: none;
		position: absolute;
	}

	.orbit-projector img {
		height: 100%;
		object-fit: contain;
		opacity: 0.55;
		transform: translateY(-28%);
		width: min(86%, 680px);
	}

	.orbit-ring {
		height: 100%;
		position: absolute;
		transform-style: preserve-3d;
		transition: transform 650ms cubic-bezier(0.2, 0.7, 0.2, 1);
		width: 100%;
		z-index: 1;
	}

	.orbit-card {
		background: var(--color-bg-dark, #122123);
		border: 0;
		border-radius: 12px;
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
		color: white;
		cursor: pointer;
		height: 280px;
		left: 50%;
		margin: -140px 0 0 -110px;
		overflow: hidden;
		position: absolute;
		top: 50%;
		transform-style: preserve-3d;
		transition: box-shadow 300ms ease;
		width: 220px;
	}

	.orbit-section[data-orbit-items] .orbit-card {
		aspect-ratio: 0.77;
		background: var(--color-text-light, #f0f4f2);
		border: 8px solid var(--color-text-light, #f0f4f2);
		border-radius: 0;
		height: auto;
		margin: 0;
		transition: transform 650ms cubic-bezier(0.2, 0.7, 0.2, 1), box-shadow 300ms ease;
		touch-action: manipulation;
		-webkit-tap-highlight-color: transparent;
		width: clamp(56px, 8.5vw, 150px);
	}

	.orbit-card:hover,
	.orbit-card[aria-current='true'] {
		box-shadow: 0 12px 32px rgba(0, 0, 0, 0.6);
	}

	.orbit-card:not([aria-current='true']) {
		pointer-events: none;
	}

	.orbit-section[data-orbit-items] .orbit-card:not([aria-current='true']) {
		pointer-events: auto;
	}

	.orbit-card:focus-visible,
	.orbit-arrow:focus-visible,
	.orbit-dialog button:focus-visible,
	.orbit-dialog a:focus-visible {
		outline: 3px solid var(--color-summer-green, #a1b8aa);
		outline-offset: 4px;
	}

	.orbit-card-image {
		height: 100%;
		object-fit: cover;
		width: 100%;
	}

	.orbit-section[data-orbit-items] .orbit-card-image {
		transition: opacity 180ms ease;
	}

	.orbit-section[data-orbit-items] .orbit-card-title {
		font-size: clamp(0.7rem, 1.4vw, 1rem);
	}

	.orbit-card-shade {
		background: linear-gradient(transparent 35%, rgba(0, 0, 0, 0.78));
		inset: 0;
		position: absolute;
	}

	.orbit-card-content {
		bottom: 16px;
		display: flex;
		flex-direction: column;
		gap: 4px;
		left: 16px;
		position: absolute;
		right: 16px;
		text-align: right;
		text-shadow: 0 2px 8px rgba(0, 0, 0, 0.8);
	}

	.orbit-card-title {
		font-size: 1.25rem;
		font-weight: 700;
		line-height: 1.2;
	}

	.orbit-card-subtitle {
		font-size: 0.8rem;
		line-height: 1.3;
	}

	.orbit-arrow {
		align-items: center;
		background: transparent;
		border: 0;
		border-radius: 50%;
		color: rgba(240, 244, 242, 0.75);
		cursor: pointer;
		display: flex;
		font-size: 3.5rem;
		height: 64px;
		justify-content: center;
		position: absolute;
		top: 50%;
		transform: translateY(-50%);
		transition: color 200ms ease, transform 200ms ease;
		width: 64px;
		z-index: 2;
	}

	.orbit-arrow:hover {
		color: white;
		transform: translateY(-50%) scale(1.12);
	}

	.orbit-arrow-previous {
		left: 0;
	}

	.orbit-arrow-next {
		right: 0;
	}

	.orbit-controls {
		align-items: center;
		display: flex;
		gap: clamp(16px, 3vw, 36px);
		justify-content: center;
		margin: 12px auto 0;
	}

	.orbit-section[data-orbit-items] .orbit-arrow {
		background: rgba(18, 33, 35, 0.6);
		flex: 0 0 auto;
		font-size: 2rem;
		height: 48px;
		position: static;
		transform: none;
		width: 48px;
	}

	.orbit-section[data-orbit-items] .orbit-arrow:hover {
		transform: scale(1.12);
	}

	.orbit-control-label {
		color: var(--color-summer-green, #a1b8aa);
		font-family: var(--font-family-accent, Georgia, serif);
		font-size: clamp(1.1rem, 2vw, 1.5rem);
		letter-spacing: 0.04em;
		text-align: center;
	}

	.orbit-dialog {
		background: var(--color-bg-dark, #122123);
		border: 1px solid rgba(161, 184, 170, 0.25);
		border-radius: 16px;
		color: var(--color-text-light, #f0f4f2);
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		margin: auto;
		max-height: min(560px, calc(100dvh - 32px));
		max-width: min(920px, calc(100vw - 32px));
		overflow: auto;
		padding: 0;
		position: fixed;
		width: 100%;
	}

	.orbit-dialog[open] {
		display: grid;
	}

	.orbit-dialog::backdrop {
		background: rgba(0, 0, 0, 0.82);
		backdrop-filter: blur(4px);
	}

	.orbit-dialog-image {
		min-height: 360px;
	}

	.orbit-dialog-image img {
		display: block;
		height: 100%;
		min-height: 360px;
		object-fit: cover;
		width: 100%;
	}

	.orbit-dialog-content {
		align-self: center;
		padding: clamp(28px, 5vw, 56px);
	}

	.orbit-dialog-content h3 {
		font-size: clamp(2rem, 4vw, 3rem);
	}

	.orbit-dialog-subtitle {
		color: var(--color-summer-green, #a1b8aa);
		font-size: 0.8rem;
		letter-spacing: 0.12em;
		margin-bottom: 12px;
		text-transform: uppercase;
	}

	.orbit-dialog-description {
		color: rgba(240, 244, 242, 0.82);
		margin-top: 20px;
	}

	.orbit-dialog-link {
		border-bottom: 1px solid currentColor;
		color: var(--color-summer-green, #a1b8aa);
		display: inline-block;
		margin-top: 28px;
		padding-bottom: 5px;
	}

	.orbit-dialog-close {
		background: rgba(18, 33, 35, 0.72);
		border: 0;
		border-radius: 50%;
		color: white;
		cursor: pointer;
		font-size: 2rem;
		height: 44px;
		line-height: 1;
		position: absolute;
		right: 12px;
		top: 12px;
		width: 44px;
		z-index: 1;
	}

	@media (max-width: 768px) {
		.orbit-section {
			padding-left: 12px;
			padding-right: 12px;
		}

